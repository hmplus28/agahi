# Django
SECRET_KEY=replace-with-a-long-random-secret
DJANGO_SETTINGS_MODULE=config.settings.production
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
SECURE_SSL_REDIRECT=true
SECURE_PROXY_SSL_HEADER=true

# This deployment is permanently offline. It always uses file cache and blocks all external integrations.
# Keep this writable directory outside public_html; it is shared safely by Passenger workers.
CACHE_DIR=/home/USERNAME/private/agahi-cache
SEO_LANDING_MIN_ADS=3

# Database (PostgreSQL must be local or on a private reachable network)
DATABASE_NAME=agahi_db
DATABASE_USER=agahi_user
DATABASE_PASSWORD=replace-with-a-strong-database-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DB_CONN_MAX_AGE=600

# External payment and SMS are intentionally disabled in the permanently offline deployment.
DEFAULT_PAYMENT_GATEWAY=disabled
SMS_ENABLED=false
SMS_PROVIDER=disabled

# Database backup: keep local, encrypted files outside public_html.
BACKUP_DIR=/home/USERNAME/private/agahi-backups
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=30
BACKUP_ENCRYPTION_KEY=replace-with-a-long-random-secret
BACKUP_PG_DUMP_BIN=pg_dump
BACKUP_PSQL_BIN=psql
BACKUP_OPENSSL_BIN=openssl
