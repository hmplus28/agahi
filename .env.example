# Django
SECRET_KEY=replace-with-a-long-random-secret
DJANGO_SETTINGS_MODULE=config.settings.production
ALLOWED_HOSTS=example.com,www.example.com
CSRF_TRUSTED_ORIGINS=https://example.com,https://www.example.com
SECURE_SSL_REDIRECT=true
SECURE_PROXY_SSL_HEADER=true
# Enable during national/internet outage: disables payment, SMS, remote backup, Redis and external email delivery.
OFFLINE_MODE=false

# Shared cache: use Redis where available, otherwise a writable path outside public web root.
# Redis is opt-in; keep false for a fully local/offline-first deployment.
ENABLE_REDIS_CACHE=false
CACHE_URL=redis://127.0.0.1:6379/1
CACHE_DIR=/home/USERNAME/private/agahi-cache
# In OFFLINE_MODE, CACHE_DIR is preferred and CACHE_URL is intentionally ignored.
SEO_LANDING_MIN_ADS=3

# Database (PostgreSQL in production)
DATABASE_NAME=agahi_db
DATABASE_USER=agahi_user
DATABASE_PASSWORD=replace-with-a-strong-database-password
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DB_CONN_MAX_AGE=600

# Payment gateway (set the selected provider only when credentials are available)
DEFAULT_PAYMENT_GATEWAY=zarinpal
ZARINPAL_MERCHANT_ID=
PAYMENT_SANDBOX=true
NEXTPAY_API_KEY=
NEXTPAY_SANDBOX=true
PAYMENT_HTTP_TIMEOUT=5

# SMS provider (disabled by default; enables only after a provider key is configured)
SMS_ENABLED=false
SMS_PROVIDER=kavenegar
SMS_SENDER_ID=
KAVENEGAR_API_KEY=
SMS_HTTP_TIMEOUT=5
SMS_MAX_ATTEMPTS=3

# Optional e-mail settings
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True

# Database backup (keep local files outside public_html; remote transfer accepts only encrypted artifacts)
BACKUP_DIR=/home/USERNAME/private/agahi-backups
BACKUP_RETENTION_DAYS=30
BACKUP_RETENTION_COUNT=30
BACKUP_ENCRYPTION_KEY=replace-with-a-long-random-secret
BACKUP_REMOTE_PROVIDER=ftps
BACKUP_REMOTE_HOST=
BACKUP_REMOTE_PORT=21
BACKUP_REMOTE_USERNAME=
BACKUP_REMOTE_PASSWORD=
BACKUP_REMOTE_PATH=agahi-backups
# Optional local/test target: BACKUP_REMOTE_PROVIDER=filesystem and a private mounted path.
# BACKUP_REMOTE_PATH=/home/USERNAME/private/offsite-backups
BACKUP_PG_DUMP_BIN=pg_dump
BACKUP_PSQL_BIN=psql
BACKUP_OPENSSL_BIN=openssl
