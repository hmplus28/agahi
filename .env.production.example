APP_NAME="سامانه آگهی"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yourdomain.ir

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
SITE_DESCRIPTION="سامانهٔ سریع و امن ثبت آگهی در ایران"

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- MySQL (هاست اشتراکی cPanel) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=yourcp_agahi
DB_USERNAME=yourcp_agahi
DB_PASSWORD=CHANGE_ME

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync

FREE_AD_DURATION_DAYS=30
MAX_AD_IMAGES=5
MAX_AD_LINKS=5
IMAGE_MAX_BYTES=5242880
IMAGE_MAX_PIXELS=24000000

CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
# --- Payment Gateway (fake | zarinpal | sadad) ---
PAYMENT_GATEWAY=fake
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=false

# --- Sadad PSP (بانک ملی) ---
SADAD_MERCHANT_ID=
SADAD_TERMINAL_ID=
SADAD_TRANSACTION_KEY=
