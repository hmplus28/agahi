# ──────────────────────────────────────────────────────────────
#  تنظیمات داکر سامانه آگهی
#  این فایل را با نام .env در کنار docker-compose.yml کپی کنید:
#      cp .env.docker.example .env
# ──────────────────────────────────────────────────────────────

# ⚠️ الزامی: کلید اپلیکیشن (اگر خالی بماند، هربار که کانتینر بازسازی شود
# کلید موقتیِ جدید ساخته می‌شود و سشن‌ها/داده‌های رمزشده خراب می‌شوند)
# تولید کلید:  openssl rand -base64 32
APP_KEY=

# آدرس عمومی سایت — برای استایل‌ها و تصاویر درست باید دقیقاً همان
# آدرسی باشد که کاربر در مرورگر باز می‌کند
APP_URL=http://localhost:8080
APP_ENV=production
APP_DEBUG=false

# پورت میزبان برای وب‌سرور (روی سرور با دامنه، 80 بگذارید)
WEB_PORT=8080

# ─── دیتابیس PostgreSQL ──────────────────────────────────────
POSTGRES_DB=agahi
POSTGRES_USER=agahi
# ⚠️ الزامی: رمز قوی برای دیتابیس انتخاب کنید
POSTGRES_PASSWORD=

# ─── سشن (وقتی APP_URL با https است true بگذارید) ────────────
SESSION_SECURE_COOKIE=false

# ─── پیامک (provider: log = لاگ محلی | ippanel = تولیدی) ─────
SMS_PROVIDER=log
IPPANEL_API_KEY=
IPPANEL_BASE_URL=https://edge.ippanel.com/v1
SMS_SENDER_NUMBER=

# ─── گزینه‌های راه‌اندازی ─────────────────────────────────────
# اجرای خودکار migration هنگام بالا آمدن کانتینر app
RUN_MIGRATIONS=true
# اجرای seeder (ساخت دسته‌بندی‌ها + کاربر ادمین 09120000000 / ChangeMe123!)
# فقط بار اول true بگذارید
RUN_SEEDER=false

# سطح لاگ: debug | info | warning | error
LOG_LEVEL=info
