.git
.github
.gitattributes
node_modules
# exclude all of vendor EXCEPT the pagination views that
# resources/css/app.css references via @source (needed by the
# "assets" build stage; documented dockerignore re-include chain)
vendor/*
!vendor/laravel
vendor/laravel/*
!vendor/laravel/framework
vendor/laravel/framework/*
!vendor/laravel/framework/src
vendor/laravel/framework/src/*
!vendor/laravel/framework/src/Illuminate
vendor/laravel/framework/src/Illuminate/*
!vendor/laravel/framework/src/Illuminate/Pagination
vendor/laravel/framework/src/Illuminate/Pagination/*
!vendor/laravel/framework/src/Illuminate/Pagination/resources
vendor/laravel/framework/src/Illuminate/Pagination/resources/*
!vendor/laravel/framework/src/Illuminate/Pagination/resources/views
public/storage
public/build
public/hot

.env
.env.*
!.env.example
!.env.production.example

storage/app/private/*
storage/app/samples/*
storage/app/public/ads/*
storage/app/public/banners/*
storage/app/public/pending-ads/*
storage/app/public/permits/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/testing/*
storage/framework/views/*
storage/logs/*

tests
phpunit.xml
.phpunit.result.cache
.phpactor.json
.pint.json
