# ─────────────────────────────────────────────────────────────────────────────
# نمونهٔ کانفیگ HTTPS برای سرویس web (بخش ۶۳ سند PRD: HTTPS اجباری)
#
# فعال‌سازی (روی سرور، بعد از گرفتن دامنه و گواهی):
#   1) گواهی‌ها را در مسیری روی هاست بگذارید، مثلاً:
#        /www/wwwroot/agahi/docker/nginx/certs/fullchain.pem
#        /www/wwwroot/agahi/docker/nginx/certs/privkey.pem
#   2) این فایل را به https.conf کپی کنید: cp https.conf.example https.conf
#   3) مسیر گواهی‌ها و server_name (دامنهٔ واقعی) را داخل آن اصلاح کنید.
#   4) در docker-compose.yml سرویس web این را اضافه کنید:
#        ports:  - "8087:80"  - "443:443"
#        volumes: - ./docker/nginx/https.conf:/etc/nginx/conf.d/https.conf:ro
#                 - ./docker/nginx/certs:/etc/nginx/certs:ro
#   5) در فایل .env سرور:
#        APP_URL=https://YOUR-DOMAIN
#        SESSION_SECURE_COOKIE=true
#      (اپ با HttpsPolicy وقتی APP_URL با https شروع شود یا پشت TLS باشد
#       خودش همهٔ URLها را https تولید می‌کند.)
#   6) docker compose up -d web
# ─────────────────────────────────────────────────────────────────────────────

# ریدایرکت همهٔ ترافیک HTTP به HTTPS
server {
    listen 80;
    server_name YOUR-DOMAIN;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name YOUR-DOMAIN;

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    root /var/www/html/public;
    index index.php index.html;

    charset utf-8;
    client_max_body_size 30m;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    location = /favicon.ico { access_log off; log_not_found off; }
    location = /robots.txt  { access_log off; log_not_found off; }

    location /storage/ {
        try_files $uri =404;
        access_log off;
        expires 7d;
    }

    location /build/ {
        try_files $uri =404;
        access_log off;
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    location ~ \.php$ {
        try_files $uri =404;
        include fastcgi_params;
        fastcgi_pass app:9000;
        fastcgi_index index.php;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_read_timeout 120s;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ /\.(?!well-known) {
        deny all;
    }
}
